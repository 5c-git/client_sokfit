mixin socials(props)
  article.socials
    ul.socials__list 

      if props.telegram
        li.socials__item 
          a(href="#").socials__link
            svg(width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg")
              use(href='#icon-social__telegram') 

      if props.twitter
        li.socials__item 
          a(href="#").socials__link
            svg(width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg")
              use(href='#icon-social__twitter') 

      if props.whatsapp
        li.socials__item 
          a(href="#").socials__link
            svg(width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg")
              use(href='#icon-social__whatsapp') 

      if props.vk
        li.socials__item 
          a(href="#").socials__link
            svg(width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg")
              use(href='#icon-social__vk') 

      if props.youtube
        li.socials__item 
          a(href="#").socials__link
            svg(width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg")
              use(href='#icon-social__youtube') 

      if props.copy
        li.socials__item 
          a(href="#").socials__link.socials__link--copy
            svg(width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg")
              use(href='#icon-social__link') 
